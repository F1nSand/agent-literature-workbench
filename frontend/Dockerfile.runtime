FROM node:24.18-alpine@sha256:f70403e87646dc51b45295f4b8b70cdad0b63d2297c4c9899119b03f7af7a6b3 AS build

WORKDIR /build
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

FROM nginx:alpine@sha256:df221db836e1754089190208cee7eeda94f233197056426eda74a43ab1abeac2 AS nginx_runtime

RUN set -eux; \
    mkdir -p /stage/usr/sbin /stage/etc/nginx /stage/usr/share/nginx/html \
        /stage/var/run /stage/var/cache/nginx/client_temp /stage/var/cache/nginx/proxy_temp \
        /stage/var/cache/nginx/fastcgi_temp /stage/var/cache/nginx/uwsgi_temp \
        /stage/var/cache/nginx/scgi_temp /stage/tmp; \
    cp /usr/sbin/nginx /stage/usr/sbin/nginx; \
    cp /etc/nginx/mime.types /stage/etc/nginx/mime.types; \
    ldd /usr/sbin/nginx | awk '{ for (i=1; i<=NF; i++) if ($i ~ /^\//) { print $i; break } }' | sort -u | \
        while read -r lib; do mkdir -p "/stage$(dirname "$lib")"; cp -L "$lib" "/stage$lib"; done
COPY nginx.production.conf /stage/etc/nginx/nginx.conf
RUN nginx -t -c /stage/etc/nginx/nginx.conf

FROM scratch

COPY --from=nginx_runtime /stage/ /
COPY --from=build /build/dist /usr/share/nginx/html
EXPOSE 80
ENTRYPOINT ["/usr/sbin/nginx"]
CMD ["-g", "daemon off;"]
